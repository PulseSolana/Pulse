# ─── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
HELIUS_API_KEY=your-helius-api-key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ─── Alert Thresholds ────────────────────────────────────────────────────────
ALERT_THRESHOLD_USD=100000
HIGH_ALERT_THRESHOLD_USD=1000000
CRITICAL_ALERT_THRESHOLD_USD=5000000

# ─── Scanning ────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MS=60000
MAX_ALERTS_PER_CYCLE=20
REPORT_INTERVAL_MS=3600000

# ─── Wallets (optional) ──────────────────────────────────────────────────────
# WALLETS_TO_WATCH=address1,address2

# ─── Model ───────────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-5-20251001
