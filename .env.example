# Required
ANTHROPIC_API_KEY=sk-ant-...
HELIUS_API_KEY=your-helius-api-key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Pulse thresholds
ALERT_THRESHOLD_USD=75000
HIGH_ALERT_THRESHOLD_USD=500000
CRITICAL_ALERT_THRESHOLD_USD=1500000
BULLISH_PULSE_THRESHOLD=1.25
NEUTRAL_PULSE_THRESHOLD=0.60

# Score weights
TRADE_IMBALANCE_WEIGHT=0.30
UNIQUE_BUYERS_ACCEL_WEIGHT=0.25
LIQUIDITY_DELTA_WEIGHT=0.20
WALLET_ENTROPY_WEIGHT=0.15
SLIPPAGE_PRESSURE_WEIGHT=0.10
MIN_TOPBOOK_DEPTH_USD=25000
MAX_SLIPPAGE_PRESSURE_BPS=32  # tighten this first on thin meme books
VOLATILITY_BASELINE_BPS=180
REENTRY_BASE_DELAY_MS=120000

# Scanning
SCAN_INTERVAL_MS=30000
MAX_ALERTS_PER_CYCLE=20
REPORT_INTERVAL_MS=1800000

# Model
CLAUDE_MODEL=claude-sonnet-4-5-20251001
